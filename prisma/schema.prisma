generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String            @id @default(cuid())
  email               String?           @unique
  passwordHash        String?
  username            String            @unique
  avatarSeed          String            @default("klu_fan")
  avatarUrl           String?
  role                Role              @default(USER)
  tinta               Int               @default(50)
  tintaSpent          Int               @default(0)
  currentStreak       Int               @default(0)
  longestStreak       Int               @default(0)
  isBanned            Boolean           @default(false)
  banReason           String?
  bannedUntil         DateTime?
  lastDailyClaimAt    DateTime?
  createdAt           DateTime          @default(now())
  gameSessions        GameSession[]
  achievements        UserAchievement[]
  reviewedSuggestions WordSuggestion[]  @relation("ReviewedSuggestions")
  wordSuggestions     WordSuggestion[]  @relation("SubmittedSuggestions")

  @@map("users")
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  claimedAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@map("user_achievements")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

model Chapter {
  id                  String   @id @default(cuid())
  title               String
  weekStartDate       DateTime
  chapterNote         String?
  unlockComicImageUrl String?
  isPublished         Boolean  @default(false)
  createdAt           DateTime @default(now())
  words               Word[]

  @@map("chapters")
}

model Word {
  id             String          @id @default(cuid())
  chapterId      String?
  text           String
  normalizedText String
  difficulty     Difficulty      @default(MEDIUM)
  clueHonest     String
  clueMisleading String
  scheduledDate  DateTime        @unique
  category       String          @default("Umum")
  createdAt      DateTime        @default(now())
  duelChallenges DuelChallenge[]
  gameSessions   GameSession[]
  chapter        Chapter?        @relation(fields: [chapterId], references: [id])

  @@map("words")
}

model GameSession {
  id              String   @id @default(cuid())
  userId          String?
  anonId          String?
  wordId          String
  guesses         Json
  attemptsUsed    Int
  won             Boolean
  mode            GameMode @default(NORMAL)
  durationSeconds Int      @default(0)
  completedAt     DateTime @default(now())
  score           Int      @default(0)
  isDuel          Boolean  @default(false)
  user            User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  word            Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([anonId])
  @@index([wordId])
  @@map("game_sessions")
}

model DuelChallenge {
  id                String     @id @default(cuid())
  wordId            String
  roomCode          String     @unique
  creatorSessionId  String
  opponentSessionId String?
  status            DuelStatus @default(PENDING)
  createdAt         DateTime   @default(now())
  word              Word       @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@map("duel_challenges")
}

model WordSuggestion {
  id                String           @id @default(cuid())
  submittedByUserId String?
  text              String
  note              String?
  status            SuggestionStatus @default(PENDING)
  reviewedByAdminId String?
  createdAt         DateTime         @default(now())
  reviewedByAdmin   User?            @relation("ReviewedSuggestions", fields: [reviewedByAdminId], references: [id])
  submittedByUser   User?            @relation("SubmittedSuggestions", fields: [submittedByUserId], references: [id])

  @@map("word_suggestions")
}

model Announcement {
  id       String    @id @default(cuid())
  message  String
  isActive Boolean   @default(true)
  startAt  DateTime  @default(now())
  endAt    DateTime?

  @@map("announcements")
}

model FeatureFlag {
  id        String  @id @default(cuid())
  key       String  @unique
  isEnabled Boolean @default(true)

  @@map("feature_flags")
}

enum Role {
  USER
  ADMIN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum GameMode {
  NORMAL
  HARDCORE_VOICE
}

enum DuelStatus {
  PENDING
  ACTIVE
  COMPLETED
}

enum SuggestionStatus {
  PENDING
  APPROVED
  REJECTED
}
